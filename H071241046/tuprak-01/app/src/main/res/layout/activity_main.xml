<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ig_black">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/ig_black"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:id="@+id/tv_main_username"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/default_username"
            android:textColor="@color/ig_white"
            android:textSize="20sp"
            android:textStyle="bold" />
    </androidx.appcompat.widget.Toolbar>

    <androidx.cardview.widget.CardView
        android:id="@+id/cv_profile"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="45dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/ig_gray_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">
        <ImageView
            android:id="@+id/iv_main_profile_photo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_gallery" /> </androidx.cardview.widget.CardView>

    <LinearLayout
        android:id="@+id/ll_stats"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="@id/cv_profile"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/cv_profile"
        app:layout_constraintTop_toTopOf="@id/cv_profile">

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:layout_weight="1">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textStyle="bold" android:textColor="@color/ig_white"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="kiriman" android:textColor="@color/ig_gray_text" android:textSize="12sp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:layout_weight="1">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="64" android:textStyle="bold" android:textColor="@color/ig_white"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="pengikut" android:textColor="@color/ig_gray_text" android:textSize="12sp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:layout_weight="1">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="116" android:textStyle="bold" android:textColor="@color/ig_white"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="diikuti" android:textColor="@color/ig_gray_text" android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_main_fullname"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:text="@string/default_fullname"
        android:textColor="@color/ig_white"
        android:textStyle="bold"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/cv_profile"
        app:layout_constraintTop_toBottomOf="@id/cv_profile" />

    <TextView
        android:id="@+id/tv_main_bio"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/default_bio"
        android:textColor="@color/ig_white"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="@id/tv_main_fullname"
        app:layout_constraintStart_toStartOf="@id/tv_main_fullname"
        app:layout_constraintTop_toBottomOf="@id/tv_main_fullname" />

    <Button
        android:id="@+id/btn_to_edit_profile"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/ig_gray_button"
        android:text="Edit profil"
        android:textAllCaps="false"
        android:textColor="@color/ig_white"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/tv_main_bio" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/ig_pure_black"
        app:itemIconTint="@color/ig_white"
        app:itemTextColor="@color/ig_white"
        app:menu="@menu/bottom_nav_menu"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>