<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ct_bg">

    <!-- Lingkaran dekorasi besar belakang -->
    <View
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:background="@drawable/bg_glow_circle"
        android:alpha="0.06"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="60dp"/>

    <!-- Logo ring -->
    <FrameLayout
        android:id="@+id/fl_logo"
        android:layout_width="100dp"
        android:layout_height="100dp"
        app:layout_constraintBottom_toTopOf="@id/tv_app_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        android:layout_marginBottom="20dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_logo_ring"/>

        <ImageView
            android:id="@+id/iv_splash_logo"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:src="@android:drawable/ic_menu_camera"
            android:contentDescription="Logo"
            app:tint="@color/ct_accent"/>
    </FrameLayout>

    <!-- App name -->
    <TextView
        android:id="@+id/tv_app_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CineTracker"
        android:textColor="@color/ct_text"
        android:textSize="36sp"
        android:textStyle="bold"
        android:letterSpacing="0.01"
        app:layout_constraintBottom_toTopOf="@id/tv_tagline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/fl_logo"/>

    <!-- Dot aksen emas -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="●"
        android:textColor="@color/ct_accent"
        android:textSize="8sp"
        android:layout_marginStart="2dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintStart_toEndOf="@id/tv_app_name"
        app:layout_constraintBottom_toBottomOf="@id/tv_app_name"/>

    <TextView
        android:id="@+id/tv_tagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Track · Discover · Enjoy"
        android:textColor="@color/ct_text_dim"
        android:textSize="14sp"
        android:letterSpacing="0.08"
        app:layout_constraintBottom_toTopOf="@id/view_progress"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_app_name"/>

    <!-- Progress bar amber -->
    <ProgressBar
        android:id="@+id/view_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="80dp"
        android:layout_height="2dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/ct_accent"
        android:layout_marginBottom="72dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_tagline"/>

</androidx.constraintlayout.widget.ConstraintLayout>
