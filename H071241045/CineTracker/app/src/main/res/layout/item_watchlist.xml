<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="14dp"
    android:layout_marginVertical="7dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@color/ct_surface"
    app:rippleColor="#22F5A623"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:orientation="horizontal">

        <!-- Poster dengan rating badge di pojok bawah -->
        <FrameLayout
            android:layout_width="85dp"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/iv_watchlist_poster"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="@color/ct_surface2"
                android:contentDescription="Poster"/>

            <!-- Rating badge pojok bawah poster -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_badge_amber_small"
                android:paddingHorizontal="6dp"
                android:paddingVertical="3dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="★ "
                    android:textColor="@color/ct_bg"
                    android:textSize="9sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tv_watchlist_rating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.0"
                    android:textColor="@color/ct_bg"
                    android:textSize="9sp"
                    android:textStyle="bold"/>
            </LinearLayout>
        </FrameLayout>

        <!-- Accent bar -->
        <View
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:background="@color/ct_accent"/>

        <!-- Konten -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="8dp"
            android:paddingTop="12dp"
            android:paddingBottom="10dp"
            android:gravity="center_vertical">

            <!-- Judul -->
            <TextView
                android:id="@+id/tv_watchlist_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Movie Title"
                android:textColor="@color/ct_text"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginBottom="5dp"/>

            <!-- Status badge dengan border + ikon -->
            <TextView
                android:id="@+id/tv_watch_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Belum Ditonton"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:background="#881B2A5E"
                android:layout_marginBottom="6dp"/>

            <!-- Overview -->
            <TextView
                android:id="@+id/tv_watchlist_overview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Overview..."
                android:textColor="@color/ct_text_dim"
                android:textSize="11sp"
                android:maxLines="2"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.3"/>
        </LinearLayout>

        <!-- Tombol hapus -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:layout_marginEnd="6dp">

            <ImageButton
                android:id="@+id/btn_delete_watchlist"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@android:drawable/ic_menu_delete"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Remove"
                app:tint="#E05252"/>
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>