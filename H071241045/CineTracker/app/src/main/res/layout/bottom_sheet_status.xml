<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/ct_surface"
    android:paddingBottom="16dp">

    <!-- Handle bar -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="4dp"
        android:background="@color/ct_text_dim"/>

    <!-- Judul film -->
    <TextView
        android:id="@+id/tv_sheet_movie_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Movie Title"
        android:textColor="@color/ct_accent"
        android:textSize="12sp"
        android:gravity="center"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="2dp"/>

    <!-- Label -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Status tonton"
        android:textColor="@color/ct_text"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingBottom="12dp"
        android:paddingHorizontal="20dp"/>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/ct_surface2"
        android:layout_marginHorizontal="16dp"/>

    <!-- Opsi: Belum Ditonton -->
    <LinearLayout
        android:id="@+id/opt_belum_ditonton"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:background="?attr/selectableItemBackground">

        <View
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:background="#FF1B2A5E"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Belum ditonton"
                android:textColor="@color/ct_text"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tersimpan di watchlist"
                android:textColor="@color/ct_text_dim"
                android:textSize="12sp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/check_belum"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✓"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:background="#CC1B2A5E"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:visibility="gone"/>
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/ct_surface2"
        android:layout_marginHorizontal="16dp"/>

    <!-- Opsi: Sedang Ditonton -->
    <LinearLayout
        android:id="@+id/opt_sedang_ditonton"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:background="?attr/selectableItemBackground">

        <View
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:background="#FFC8960C"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sedang ditonton"
                android:textColor="@color/ct_text"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lagi nonton nih"
                android:textColor="@color/ct_text_dim"
                android:textSize="12sp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/check_sedang"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✓"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:background="#CCC8960C"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:visibility="gone"/>
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/ct_surface2"
        android:layout_marginHorizontal="16dp"/>

    <!-- Opsi: Sudah Ditonton -->
    <LinearLayout
        android:id="@+id/opt_sudah_ditonton"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:background="?attr/selectableItemBackground">

        <View
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:background="#FF4CAF50"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sudah ditonton"
                android:textColor="@color/ct_text"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Selesai ditonton"
                android:textColor="@color/ct_text_dim"
                android:textSize="12sp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/check_sudah"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✓"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:background="#CC4CAF50"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:visibility="gone"/>
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/ct_surface2"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"/>

    <!-- Tombol Batal -->
    <TextView
        android:id="@+id/tv_sheet_cancel"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Batal"
        android:textColor="@color/ct_accent"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:background="?attr/selectableItemBackground"/>

</LinearLayout>