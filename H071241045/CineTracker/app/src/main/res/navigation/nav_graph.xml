<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/navigation_home">

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.example.cinetracker.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_home_to_detail"
            app:destination="@id/navigation_detail"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <fragment
        android:id="@+id/navigation_watchlist"
        android:name="com.example.cinetracker.WatchlistFragment"
        android:label="Watchlist"
        tools:layout="@layout/fragment_watchlist" />

    <fragment
        android:id="@+id/navigation_detail"
        android:name="com.example.cinetracker.DetailFragment"
        android:label="Detail Film"
        tools:layout="@layout/fragment_detail">
        <!-- SEMUA pakai String agar konsisten, rating dikonversi manual di Java -->
        <argument android:name="title"       app:argType="string" android:defaultValue="" />
        <argument android:name="overview"    app:argType="string" android:defaultValue="" />
        <argument android:name="poster_path" app:argType="string" android:defaultValue="" />
        <argument android:name="rating"      app:argType="string" android:defaultValue="0.0" />
    </fragment>

</navigation>
